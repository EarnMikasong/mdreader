# ============================================================
# mdreader 仓库忽略规则
# ============================================================

# ---- Python ----
__pycache__/
*.pyc
venv/
.venv/

# ---- Node（以后要是写前端小工具）----
node_modules/

# ---- 打包 / 构建产物（exe 不入库：Release 发布或拷文件夹分发）----
build/
dist/
*.spec
*.exe
*.zip

# ---- IDE / 编辑器 ----
.idea/
.vscode/

# ---- 日志、临时文件 ----
*.log
*.tmp
.test-state*/
.release-staging/

# ---- Windows 系统垃圾 ----
Thumbs.db
desktop.ini
